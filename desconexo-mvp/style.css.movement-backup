:root{--paper:#d7d0bc;--blood:#901f2d;--ink:#151311}
*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#050505;color:#eee;font-family:Georgia,"Times New Roman",serif}#game{width:100%;height:100%;display:block;touch-action:none}#vignette{position:fixed;inset:0;pointer-events:none;background:radial-gradient(circle,transparent 38%,rgba(0,0,0,.20) 70%,rgba(0,0,0,.62) 100%);mix-blend-mode:multiply}#crosshair{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);font:24px Arial;color:rgba(255,255,255,.75);text-shadow:0 0 8px #000;pointer-events:none}#prompt{position:fixed;left:50%;top:58%;transform:translateX(-50%);min-width:220px;text-align:center;font:600 15px Arial;letter-spacing:.08em;text-transform:uppercase;text-shadow:0 2px 5px #000}#objective{position:fixed;left:24px;top:22px;max-width:360px;font:600 14px Arial;letter-spacing:.04em;color:#ddd;text-shadow:0 2px 4px #000}#objective:before{content:"OBJECTIVE";display:block;color:#a63b45;font-size:11px;letter-spacing:.2em;margin-bottom:5px}#status{position:fixed;right:24px;top:22px;text-align:right;font:600 13px Arial;color:#ccc;text-shadow:0 2px 4px #000}#subtitle{position:fixed;left:50%;bottom:8%;transform:translateX(-50%);width:min(760px,80%);text-align:center;font-size:20px;text-shadow:0 2px 6px #000;opacity:0;transition:opacity .25s}.panel{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.82);backdrop-filter:blur(5px);z-index:10}.panel.visible{display:flex}.card{width:min(620px,90vw);padding:38px 42px;background:linear-gradient(145deg,#171411,#090807);border:1px solid #4c4139;box-shadow:0 24px 80px #000;text-align:center}.card h1{font-size:56px;letter-spacing:.16em;margin:8px 0 16px;color:#e5ded0;text-shadow:3px 3px 0 #631722}.card h2{font-size:30px}.card p{line-height:1.55;color:#c8c0b6}.eyebrow{font:700 11px Arial;letter-spacing:.3em;color:#9e333d}.controls{font-family:Arial;font-size:13px}.small{font-size:12px;opacity:.7}button{border:1px solid #9d3942;background:#7b2029;color:white;padding:13px 24px;margin:8px;font:700 12px Arial;letter-spacing:.14em;cursor:pointer}button:hover{background:#9f2a36}.secondary{background:transparent;border-color:#665b54;color:#aaa}.note-card{background:var(--paper);color:var(--ink);text-align:left;transform:rotate(-.4deg);box-shadow:0 24px 80px #000,inset 0 0 70px rgba(85,56,25,.18)}.note-card p{color:#241f1b;font-family:"Courier New",monospace}.note-card button{display:block;margin:25px auto 0}.album-card{background:#230d0d;border-color:#653333}.photo{height:240px;margin:22px auto;background:radial-gradient(circle at 50% 28%,#beaaa0 0 10%,#ded5c7 11% 26%,#5c151b 27% 29%,#28201e 30% 100%);display:flex;align-items:flex-end;justify-content:center;border:10px solid #2d221c;box-shadow:inset 0 0 45px #000}.photo span{margin:15px;color:#9f1f2c;font:bold 30px "Courier New";transform:rotate(-8deg)}body.distorted #vignette{background:radial-gradient(circle,rgba(75,0,0,.06) 30%,rgba(35,0,0,.62) 72%,#000 100%);animation:pulse 1.8s infinite}body.distorted #crosshair{color:#b13a43}body.distorted #game{filter:saturate(.65) contrast(1.16)}@keyframes pulse{50%{opacity:.72}}

